NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/inventory_management
# Dedicated isolated PostgreSQL database for backend integration tests (`*_test` required)
DATABASE_URL_TEST=postgresql://postgres:YOUR_PASSWORD@localhost:5432/inventory_management_test
BUSINESS_TIMEZONE=Asia/Jakarta

CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=ims_session
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Comma-separated trusted reverse proxy IPs or CIDRs (empty = do not trust forwarded headers)
TRUSTED_PROXY_IPS=
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
ENABLE_SWAGGER=true

# Optional: required only when running development seed (`bun run db:seed`)
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_MIN_8_CHARS
