meta {
  name: Get Dashboard Summary (Staff)
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}{{apiPrefix}}/dashboard
  body: none
  auth: none
}

tests {
  test("Staff views dashboard metrics cleanly without price fields", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.have.property("summary");
    expect(res.body.data).to.have.property("lowStockProducts");
  });
}
