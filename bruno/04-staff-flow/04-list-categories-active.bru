meta {
  name: List Active Categories (Staff)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}{{apiPrefix}}/categories?page=1&pageSize=10
  body: none
  auth: none
}

tests {
  test("Staff sees only active categories", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    for (const cat of res.body.data) {
      expect(cat.isActive).to.equal(true);
    }
  });
}
