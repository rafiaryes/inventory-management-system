meta {
  name: Sort Products By Price Forbidden (Staff 403)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}{{apiPrefix}}/products?sortBy=purchasePrice
  body: none
  auth: none
}

tests {
  test("rejects Staff price sorting with 403 FORBIDDEN", function() {
    expect(res.status).to.equal(403);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal("FORBIDDEN");
  });
}
