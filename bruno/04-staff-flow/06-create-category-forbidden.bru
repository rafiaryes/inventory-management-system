meta {
  name: Create Category Forbidden (Staff 403)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}{{apiPrefix}}/categories
  body: json
  auth: none
}

body:json {
  {
    "name": "Unauthorized Staff Category"
  }
}

tests {
  test("forbids Staff category creation with 403 FORBIDDEN", function() {
    expect(res.status).to.equal(403);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal("FORBIDDEN");
  });
}
