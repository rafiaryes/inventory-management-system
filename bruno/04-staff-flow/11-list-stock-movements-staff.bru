meta {
  name: List Stock Movements (Staff Includes Inactive Product History)
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}{{apiPrefix}}/stock-movements?page=1&pageSize=10&productId={{createdProductId}}
  body: none
  auth: none
}

tests {
  test("Staff can inspect historical movements for deactivated products without prices", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    expect(res.body.data.length).to.be.at.least(1);
    for (const mov of res.body.data) {
      expect(mov.product).to.not.have.property("purchasePrice");
      expect(mov.product).to.not.have.property("sellingPrice");
    }
  });
}
