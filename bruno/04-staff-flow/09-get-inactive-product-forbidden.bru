meta {
  name: Get Inactive Product Forbidden (Staff 403)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}{{apiPrefix}}/products/{{createdProductId}}
  body: none
  auth: none
}

tests {
  test("rejects Staff detail access for inactive product with 403 FORBIDDEN", function() {
    expect(res.status).to.equal(403);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal("FORBIDDEN");
  });
}
