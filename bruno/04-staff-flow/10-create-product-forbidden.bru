meta {
  name: Create Product Forbidden (Staff 403)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}{{apiPrefix}}/products
  body: json
  auth: none
}

body:json {
  {
    "categoryId": "{{createdCategoryId}}",
    "sku": "STAFF-DENY-1",
    "name": "Unauthorized Staff Product",
    "unit": "pcs",
    "purchasePrice": "1000.00",
    "sellingPrice": "1500.00"
  }
}

tests {
  test("forbids Staff product creation with 403 FORBIDDEN", function() {
    expect(res.status).to.equal(403);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal("FORBIDDEN");
  });
}
