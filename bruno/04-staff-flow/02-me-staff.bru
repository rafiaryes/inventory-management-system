meta {
  name: Get Current Staff Session
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}{{apiPrefix}}/auth/me
  body: none
  auth: none
}

tests {
  test("returns active authenticated staff user", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.user.role).to.equal("staff");
  });
}
