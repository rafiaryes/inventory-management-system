meta {
  name: List Products (Staff Price-Free)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}{{apiPrefix}}/products?page=1&pageSize=10
  body: none
  auth: none
}

tests {
  test("Staff receives active products WITHOUT purchasePrice or sellingPrice", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    for (const product of res.body.data) {
      expect(product.status).to.equal("active");
      expect(product).to.not.have.property("purchasePrice");
      expect(product).to.not.have.property("sellingPrice");
    }
  });
}
