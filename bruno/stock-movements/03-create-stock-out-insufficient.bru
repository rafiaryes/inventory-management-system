meta {
  name: Create Stock Out Insufficient Stock
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}{{apiPrefix}}/stock-movements
  body: json
  auth: none
}

body:json {
  {
    "productId": "{{createdProductId}}",
    "type": "out",
    "quantity": "999999",
    "reason": "Uji penolakan stok negatif"
  }
}

tests {
  test("rejects Stock Out exceeding currentStock with 422 INSUFFICIENT_STOCK", function() {
    expect(res.status).to.equal(422);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal("INSUFFICIENT_STOCK");
  });
}
