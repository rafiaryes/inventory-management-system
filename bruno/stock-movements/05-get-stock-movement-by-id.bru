meta {
  name: Get Stock Movement Detail
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}{{apiPrefix}}/stock-movements/{{createdMovementId}}
  body: none
  auth: none
}

tests {
  test("returns immutable movement detail", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.id).to.equal(bru.getEnvVar("createdMovementId"));
  });
}
