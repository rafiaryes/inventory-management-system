meta {
  name: Create Stock In (Admin or Staff)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}{{apiPrefix}}/stock-movements
  body: json
  auth: none
}

body:json {
  {
    "productId": "{{createdProductId}}",
    "type": "in",
    "quantity": "15",
    "reason": "Penerimaan stok awal dari supplier",
    "notes": "SJ-BRUNO-001"
  }
}

script:post-response {
  if (res.status === 201 && res.body?.data?.id) {
    bru.setEnvVar("createdMovementId", res.body.data.id);
  }
}

tests {
  test("creates atomic Stock In movement without exposing prices", function() {
    expect(res.status).to.equal(201);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.type).to.equal("in");
    expect(res.body.data.quantity).to.equal("15.000");
    expect(res.body.data).to.not.have.property("purchasePrice");
    expect(res.body.data.product).to.not.have.property("purchasePrice");
  });
}
