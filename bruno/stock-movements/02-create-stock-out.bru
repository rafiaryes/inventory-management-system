meta {
  name: Create Stock Out (Admin or Staff)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}{{apiPrefix}}/stock-movements
  body: json
  auth: none
}

body:json {
  {
    "productId": "{{createdProductId}}",
    "type": "out",
    "quantity": "4",
    "reason": "Pengiriman pesanan pelanggan",
    "notes": "DO-BRUNO-001"
  }
}

tests {
  test("creates atomic Stock Out movement", function() {
    expect(res.status).to.equal(201);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.type).to.equal("out");
    expect(res.body.data.quantity).to.equal("4.000");
  });
}
