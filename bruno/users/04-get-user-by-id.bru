meta {
  name: Get User Detail (Admin)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}{{apiPrefix}}/users/{{createdUserId}}
  body: none
  auth: none
}

tests {
  test("returns user detail", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.id).to.equal(bru.getEnvVar("createdUserId"));
  });
}
