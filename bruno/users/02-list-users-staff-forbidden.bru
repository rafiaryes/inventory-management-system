meta {
  name: List Users Forbidden (Staff)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}{{apiPrefix}}/users?page=1&pageSize=10
  body: none
  auth: none
}

tests {
  test("rejects Staff access with 403 FORBIDDEN", function() {
    expect(res.status).to.equal(403);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal("FORBIDDEN");
  });
}
