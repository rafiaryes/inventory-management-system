meta {
  name: List Inactive Categories Forbidden (Staff)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}{{apiPrefix}}/categories?isActive=false
  body: none
  auth: none
}

tests {
  test("forbids Staff from querying inactive categories", function() {
    expect(res.status).to.equal(403);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal("FORBIDDEN");
  });
}
