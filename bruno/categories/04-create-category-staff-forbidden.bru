meta {
  name: Create Category Forbidden (Staff)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}{{apiPrefix}}/categories
  body: json
  auth: none
}

body:json {
  {
    "name": "Kategori Ilegal Staff"
  }
}

tests {
  test("forbids Staff from creating category", function() {
    expect(res.status).to.equal(403);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal("FORBIDDEN");
  });
}
