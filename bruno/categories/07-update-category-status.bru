meta {
  name: Update Category Status (Admin)
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}{{apiPrefix}}/categories/{{createdCategoryId}}/status
  body: json
  auth: none
}

body:json {
  {
    "isActive": true
  }
}

tests {
  test("updates category active status", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.isActive).to.equal(true);
  });
}
