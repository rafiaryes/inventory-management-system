meta {
  name: List Products (Admin)
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}{{apiPrefix}}/products?page=1&pageSize=10&status=all
  body: none
  auth: none
}

tests {
  test("Admin receives purchasePrice and sellingPrice fields", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    for (const product of res.body.data) {
      expect(product).to.have.property("purchasePrice");
      expect(product).to.have.property("sellingPrice");
    }
  });
}
