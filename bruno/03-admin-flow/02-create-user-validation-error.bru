meta {
  name: Create User Validation Error (400)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}{{apiPrefix}}/users
  body: json
  auth: none
}

body:json {
  {
    "name": "Invalid Password User",
    "email": "invalid-pass-bruno@example.com",
    "password": "short",
    "role": "staff"
  }
}

tests {
  test("rejects short password with 400 VALIDATION_ERROR", function() {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal("VALIDATION_ERROR");
  });
}
