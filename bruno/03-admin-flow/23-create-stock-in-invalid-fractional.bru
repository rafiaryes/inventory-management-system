meta {
  name: Create Stock In Fractional Count-Only (422)
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}{{apiPrefix}}/stock-movements
  body: json
  auth: none
}

body:json {
  {
    "productId": "{{createdProductId}}",
    "type": "in",
    "quantity": "1.5",
    "reason": "Pengujian presisi count-only"
  }
}

tests {
  test("rejects fractional quantity for count-only unit with 422 INVALID_UNIT_QUANTITY", function() {
    expect(res.status).to.equal(422);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal("INVALID_UNIT_QUANTITY");
  });
}
