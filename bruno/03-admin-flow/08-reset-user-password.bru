meta {
  name: Reset User Password (Admin)
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}{{apiPrefix}}/users/{{createdUserId}}/password
  body: json
  auth: none
}

body:json {
  {
    "newPassword": "{{resetUserPassword}}"
  }
}

tests {
  test("resets user password and revokes sessions", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}
