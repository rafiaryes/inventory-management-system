meta {
  name: Update User (Admin)
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}{{apiPrefix}}/users/{{createdUserId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "Staff Demo Bruno Updated"
  }
}

tests {
  test("updates user profile name", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.name).to.equal("Staff Demo Bruno Updated");
  });
}
