meta {
  name: Get Category Detail (Admin)
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}{{apiPrefix}}/categories/{{createdCategoryId}}
  body: none
  auth: none
}

tests {
  test("returns created category detail", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.id).to.equal(bru.getEnvVar("createdCategoryId"));
  });
}
