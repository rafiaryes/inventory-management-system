meta {
  name: Create User Duplicate Email (409)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}{{apiPrefix}}/users
  body: json
  auth: none
}

body:json {
  {
    "name": "Duplicate Email User",
    "email": "{{dynamicUserEmail}}",
    "password": "{{newUserPassword}}",
    "role": "staff"
  }
}

tests {
  test("rejects duplicate email with 409 DUPLICATE_EMAIL", function() {
    expect(res.status).to.equal(409);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal("DUPLICATE_EMAIL");
  });
}
