meta {
  name: Create Product Validation Error (400)
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}{{apiPrefix}}/products
  body: json
  auth: none
}

body:json {
  {
    "categoryId": "{{createdCategoryId}}",
    "sku": "BAD-SCALE-1",
    "name": "Invalid Price Scale Product",
    "unit": "pcs",
    "purchasePrice": "1000.123",
    "sellingPrice": "1500.00"
  }
}

tests {
  test("rejects excess decimal precision with 400 VALIDATION_ERROR", function() {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal("VALIDATION_ERROR");
  });
}
