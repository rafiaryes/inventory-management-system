meta {
  name: Get Product Not Found (404)
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}{{apiPrefix}}/products/00000000-0000-4000-8000-000000000000
  body: none
  auth: none
}

tests {
  test("returns 404 RESOURCE_NOT_FOUND for unknown product ID", function() {
    expect(res.status).to.equal(404);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal("RESOURCE_NOT_FOUND");
  });
}
