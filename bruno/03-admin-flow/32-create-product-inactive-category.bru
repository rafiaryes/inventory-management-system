meta {
  name: Create Product Inactive Category (422)
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}{{apiPrefix}}/products
  body: json
  auth: none
}

body:json {
  {
    "categoryId": "{{createdCategoryId}}",
    "sku": "{{dynamicProductSku}}-FAIL",
    "name": "Blocked Inactive Category Product",
    "unit": "pcs",
    "purchasePrice": "50000.00",
    "sellingPrice": "75000.00"
  }
}

tests {
  test("rejects inactive category assignment with 422 INACTIVE_CATEGORY", function() {
    expect(res.status).to.equal(422);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal("INACTIVE_CATEGORY");
  });
}
