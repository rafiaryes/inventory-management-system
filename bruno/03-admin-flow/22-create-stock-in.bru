meta {
  name: Create Stock In (Admin)
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}{{apiPrefix}}/stock-movements
  body: json
  auth: none
}

body:json {
  {
    "productId": "{{createdProductId}}",
    "type": "in",
    "quantity": "10",
    "reason": "Pembelian awal stok uji Bruno"
  }
}

script:post-response {
  if (res.status === 201 && res.body?.data?.id) {
    bru.setEnvVar("createdMovementId", res.body.data.id);
  }
}

tests {
  test("creates atomic Stock In movement without exposing product prices", function() {
    expect(res.status).to.equal(201);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.stockBefore).to.equal("0.000");
    expect(res.body.data.stockAfter).to.equal("10.000");
    expect(res.body.data.product).to.not.have.property("purchasePrice");
    expect(res.body.data.product).to.not.have.property("sellingPrice");
  });
}
