meta {
  name: Create Stock In Inactive Product (422)
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}{{apiPrefix}}/stock-movements
  body: json
  auth: none
}

body:json {
  {
    "productId": "{{createdProductId}}",
    "type": "in",
    "quantity": "1",
    "reason": "Harus gagal karena produk nonaktif"
  }
}

tests {
  test("blocks movement on inactive product with 422 INACTIVE_PRODUCT", function() {
    expect(res.status).to.equal(422);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal("INACTIVE_PRODUCT");
  });
}
