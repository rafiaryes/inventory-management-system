meta {
  name: Create Product (Admin)
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}{{apiPrefix}}/products
  body: json
  auth: none
}

body:json {
  {
    "categoryId": "{{createdCategoryId}}",
    "sku": "{{dynamicProductSku}}",
    "name": "Laptop Testing Bruno",
    "description": "Perangkat uji integrasi Bruno",
    "unit": "pcs",
    "purchasePrice": "7500000.00",
    "sellingPrice": "9200000.00",
    "minimumStock": "2"
  }
}

script:post-response {
  if (res.status === 201 && res.body?.data?.id) {
    bru.setEnvVar("createdProductId", res.body.data.id);
  }
}

tests {
  test("creates product with zero initial stock and prices visible to Admin", function() {
    expect(res.status).to.equal(201);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.currentStock).to.equal("0.000");
    expect(res.body.data.purchasePrice).to.equal("7500000.00");
    expect(res.body.data.sellingPrice).to.equal("9200000.00");
  });
}
