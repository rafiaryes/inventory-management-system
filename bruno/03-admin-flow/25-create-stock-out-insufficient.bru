meta {
  name: Create Stock Out Insufficient Stock (422)
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}{{apiPrefix}}/stock-movements
  body: json
  auth: none
}

body:json {
  {
    "productId": "{{createdProductId}}",
    "type": "out",
    "quantity": "9999",
    "reason": "Pengujian stok tidak mencukupi"
  }
}

tests {
  test("blocks negative stock with 422 INSUFFICIENT_STOCK", function() {
    expect(res.status).to.equal(422);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal("INSUFFICIENT_STOCK");
  });
}
