meta {
  name: Deactivate User Status (Admin)
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}{{apiPrefix}}/users/{{createdUserId}}/status
  body: json
  auth: none
}

body:json {
  {
    "isActive": false
  }
}

tests {
  test("deactivates user account cleanly", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.isActive).to.equal(false);
  });
}
