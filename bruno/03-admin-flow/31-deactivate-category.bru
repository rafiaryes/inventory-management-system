meta {
  name: Deactivate Category (Admin)
  type: http
  seq: 31
}

patch {
  url: {{baseUrl}}{{apiPrefix}}/categories/{{createdCategoryId}}/status
  body: json
  auth: none
}

body:json {
  {
    "isActive": false
  }
}

tests {
  test("deactivates category cleanly", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.isActive).to.equal(false);
  });
}
