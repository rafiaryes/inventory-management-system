meta {
  name: List Users (Admin)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}{{apiPrefix}}/users?page=1&pageSize=10&sortBy=createdAt&sortOrder=desc
  body: none
  auth: none
}

tests {
  test("returns paginated user list for Admin", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta).to.have.property("totalItems");
  });
}
