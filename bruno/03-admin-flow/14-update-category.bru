meta {
  name: Update Category (Admin)
  type: http
  seq: 14
}

patch {
  url: {{baseUrl}}{{apiPrefix}}/categories/{{createdCategoryId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "{{dynamicCategoryName}} Updated",
    "description": "Deskripsi kategori diperbarui"
  }
}

tests {
  test("updates category metadata", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.description).to.equal("Deskripsi kategori diperbarui");
  });
}
