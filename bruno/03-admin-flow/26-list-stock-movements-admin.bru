meta {
  name: List Stock Movements (Admin)
  type: http
  seq: 26
}

get {
  url: {{baseUrl}}{{apiPrefix}}/stock-movements?page=1&pageSize=10
  body: none
  auth: none
}

tests {
  test("returns paginated stock movement history without exposing price fields", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    for (const mov of res.body.data) {
      expect(mov.product).to.not.have.property("purchasePrice");
      expect(mov.product).to.not.have.property("sellingPrice");
    }
  });
}
