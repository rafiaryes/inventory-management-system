meta {
  name: Login Staff
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}{{apiPrefix}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{staffEmail}}",
    "password": "{{staffPassword}}"
  }
}

tests {
  test("Staff login succeeds and returns role staff", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.user.role).to.equal("staff");
  });
}
