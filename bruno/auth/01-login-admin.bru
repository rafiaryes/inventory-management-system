meta {
  name: Login Admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}{{apiPrefix}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

tests {
  test("Admin login succeeds and returns role admin", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.user.role).to.equal("admin");
  });
}
