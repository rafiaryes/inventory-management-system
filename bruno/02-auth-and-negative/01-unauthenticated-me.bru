meta {
  name: Me Unauthenticated (401)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}{{apiPrefix}}/auth/me
  body: none
  auth: none
}

tests {
  test("rejects unauthenticated request with 401 UNAUTHENTICATED", function() {
    expect(res.status).to.equal(401);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal("UNAUTHENTICATED");
  });
}
