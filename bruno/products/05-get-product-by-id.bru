meta {
  name: Get Product Detail
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}{{apiPrefix}}/products/{{createdProductId}}
  body: none
  auth: none
}

tests {
  test("returns product detail", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.id).to.equal(bru.getEnvVar("createdProductId"));
  });
}
