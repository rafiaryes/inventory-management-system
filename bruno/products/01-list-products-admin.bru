meta {
  name: List Products (Admin with Prices)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}{{apiPrefix}}/products?page=1&pageSize=10&status=all&sortBy=createdAt&sortOrder=desc
  body: none
  auth: none
}

tests {
  test("returns paginated products with prices for Admin", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    if (res.body.data.length > 0) {
      expect(res.body.data[0]).to.have.property("purchasePrice");
      expect(res.body.data[0]).to.have.property("sellingPrice");
    }
  });
}
