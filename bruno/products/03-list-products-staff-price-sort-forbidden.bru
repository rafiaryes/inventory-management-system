meta {
  name: Sort Products By Price Forbidden (Staff)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}{{apiPrefix}}/products?sortBy=sellingPrice
  body: none
  auth: none
}

tests {
  test("forbids Staff from sorting by price fields", function() {
    expect(res.status).to.equal(403);
    expect(res.body.success).to.equal(false);
    expect(res.body.error.code).to.equal("FORBIDDEN");
  });
}
