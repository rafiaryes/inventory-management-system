meta {
  name: List Products (Staff Price-Free)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}{{apiPrefix}}/products?page=1&pageSize=10&sortBy=createdAt&sortOrder=desc
  body: none
  auth: none
}

tests {
  test("returns active products without prices for Staff", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    for (const item of res.body.data) {
      expect(item.status).to.equal("active");
      expect(item).to.not.have.property("purchasePrice");
      expect(item).to.not.have.property("sellingPrice");
    }
  });
}
