meta {
  name: Update Product Status (Admin)
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}{{apiPrefix}}/products/{{createdProductId}}/status
  body: json
  auth: none
}

body:json {
  {
    "status": "active"
  }
}

tests {
  test("updates product status", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.status).to.equal("active");
  });
}
