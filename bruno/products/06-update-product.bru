meta {
  name: Update Product (Admin)
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}{{apiPrefix}}/products/{{createdProductId}}
  body: json
  auth: none
}

body:json {
  {
    "sellingPrice": "120000.00",
    "minimumStock": "6"
  }
}

tests {
  test("updates product pricing and minimum stock", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.sellingPrice).to.equal("120000.00");
    expect(res.body.data.minimumStock).to.equal("6.000");
  });
}
