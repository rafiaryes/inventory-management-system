meta {
  name: Get Dashboard Overview (Admin or Staff)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}{{apiPrefix}}/dashboard
  body: none
  auth: none
}

tests {
  test("returns unified price-free dashboard summary, lowStockProducts, and recentStockMovements", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.summary).to.have.all.keys(
      "activeProductCount",
      "activeCategoryCount",
      "lowStockCount",
      "stockInCount",
      "stockOutCount"
    );
    expect(res.body.data.lowStockProducts.length).to.be.at.most(10);
    expect(res.body.data.recentStockMovements.length).to.be.at.most(10);
    for (const mov of res.body.data.recentStockMovements) {
      expect(mov).to.not.have.property("notes");
      expect(mov.product).to.not.have.property("purchasePrice");
    }
  });
}
